<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/splash_gradient" android:padding="24dp">
    <ImageView android:id="@+id/cover" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="12dp" android:src="@drawable/artwork_placeholder" android:scaleType="centerCrop" android:contentDescription="Album artwork" />
    <TextView android:id="@+id/song_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select a song" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" android:gravity="center" android:maxLines="2" />
    <TextView android:id="@+id/song_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDDDDD" android:textSize="16sp" android:gravity="center" android:paddingTop="4dp" />
    <SeekBar android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:progressTint="#FFFFFF" android:thumbTint="#FFFFFF" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/previous" android:layout_width="64dp" android:layout_height="64dp" android:src="@android:drawable/ic_media_previous" android:contentDescription="Previous" />
        <ImageButton android:id="@+id/play_pause" android:layout_width="76dp" android:layout_height="76dp" android:src="@android:drawable/ic_media_play" android:contentDescription="Play or pause" />
        <ImageButton android:id="@+id/next" android:layout_width="64dp" android:layout_height="64dp" android:src="@android:drawable/ic_media_next" android:contentDescription="Next" />
    </LinearLayout>
</LinearLayout>
