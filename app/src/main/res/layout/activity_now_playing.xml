<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/splash_gradient" android:padding="24dp">
    <ImageView android:id="@+id/cover" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_margin="12dp" android:src="@drawable/artwork_placeholder" android:scaleType="centerCrop" android:contentDescription="Album artwork" />
    <TextView android:id="@+id/song_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select a song" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" android:gravity="center" android:maxLines="2" />
    <TextView android:id="@+id/song_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#DDDDDD" android:textSize="16sp" android:gravity="center" android:paddingTop="4dp" />
    <TextView android:id="@+id/song_album" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="14sp" android:gravity="center" android:paddingTop="3dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/current_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textColor="#DDDDDD"/><SeekBar android:id="@+id/progress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressTint="#FFFFFF" android:thumbTint="#FFFFFF"/><TextView android:id="@+id/total_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textColor="#DDDDDD"/></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal"><ImageButton android:id="@+id/shuffle" android:layout_width="52dp" android:layout_height="52dp" android:src="@android:drawable/ic_menu_rotate" android:contentDescription="Toggle shuffle"/><ImageButton android:id="@+id/favorite" android:layout_width="52dp" android:layout_height="52dp" android:src="@android:drawable/btn_star_big_off" android:contentDescription="Toggle favourite"/><ImageButton android:id="@+id/open_queue" android:layout_width="52dp" android:layout_height="52dp" android:src="@android:drawable/ic_menu_sort_by_size" android:contentDescription="Open playback queue"/><ImageButton android:id="@+id/open_lyrics" android:layout_width="52dp" android:layout_height="52dp" android:src="@android:drawable/ic_menu_info_details" android:contentDescription="Open local lyrics"/><ImageButton android:id="@+id/start_radio" android:layout_width="52dp" android:layout_height="52dp" android:src="@android:drawable/ic_media_ff" android:contentDescription="Start local radio"/><ImageButton android:id="@+id/repeat" android:layout_width="52dp" android:layout_height="52dp" android:src="@android:drawable/ic_menu_revert" android:contentDescription="Change repeat mode"/></LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/previous" android:layout_width="64dp" android:layout_height="64dp" android:src="@android:drawable/ic_media_previous" android:contentDescription="Previous" />
        <ImageButton android:id="@+id/play_pause" android:layout_width="76dp" android:layout_height="76dp" android:src="@android:drawable/ic_media_play" android:contentDescription="Play or pause" />
        <ImageButton android:id="@+id/next" android:layout_width="64dp" android:layout_height="64dp" android:src="@android:drawable/ic_media_next" android:contentDescription="Next" />
    </LinearLayout>
</LinearLayout>
